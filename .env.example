# PromptAdsCraft AI - Environment Configuration
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# OpenAI API Key (required for live AI generation)
OPENAI_API_KEY=your_openai_api_key_here

# Model name (default: gpt-4o-mini, can use gpt-4o, gpt-3.5-turbo, etc.)
OPENAI_MODEL=gpt-4o-mini

# Maximum tokens per request (optional, default 2000)
MAX_TOKENS=2000

# Request timeout in seconds (optional, default 30)
REQUEST_TIMEOUT=30

# Storage path for campaign history (optional, default: campaigns.json)
CAMPAIGN_STORAGE_PATH=campaigns.json
